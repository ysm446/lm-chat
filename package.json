{
  "name": "lm-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Local LLM chat app with workspace-scoped memory",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc -b && npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron:dev": "npm run build:main && electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
